@using GCTL.Core.Configurations
@model IEnumerable<GCTL.Core.ViewModels.AccessCodes.AccessCodeModel>
@inject ApplicationSettings applicationSettings
@{
    var controller = "Companies";
}


<style>
    /* Styling for the nested menu */
    .sidebar-menu li > a {
        padding: 8px 5px 8px 15px;
        display: block;
        color: #b8c7ce;
    }

        .sidebar-menu li > a > .fa-angle-left {
            width: auto;
            height: auto;
            padding: 0;
            margin-right: 10px;
            margin-top: 3px;
            transition: transform 0.3s ease-in-out;
        }

    .sidebar-menu li.menu-open > a > .fa-angle-left {
        transform: rotate(-90deg);
    }

    .sidebar-submenu {
        display: none;
        list-style: none;
        padding-left: 5px;
        margin: 0 1px;
        background: #2c3b41;
    }

    .sidebar-menu .menu-open > .sidebar-submenu {
        display: block;
    }

    .sidebar-submenu.third-level {
        background: #1e2a2f;
    }

    .sidebar-menu .sidebar-submenu li > a {
        padding: 5px 5px 5px 15px;
        display: block;
        font-size: 14px;
        color: #8aa4af;
    }

        .sidebar-menu .sidebar-submenu li > a:hover {
            color: #fff;
            background: #1e282c;
        }

    .sidebar-menu .sidebar-submenu .third-level li > a {
        padding-left: 25px;
        font-size: 13px;
    }

    .sidebar-menu a {
        text-decoration: none !important;
    }
</style>


<!-- Main Sidebar Container -->
<div id="left_menu" class="sidenav">
    <section class="">
        <ul class="sidebar-menu">
            <li class="sidebar-header">
                <img src="~/images/CoIcon.ico" alt="AdminLTE Logo" class="brand-image img-circle"
                     style="opacity: .8">
                <span class="brand-text font-weight-light pl-1">GCTL Software</span>
            </li>
            <li>
                <a href="#">
                    <i class="fa fa-tachometer-alt"></i> <span>Dashboard</span></i>
                </a>
            </li>
            @if (Model.Any())
            {
                var urlPath = string.IsNullOrWhiteSpace(applicationSettings.VirtualPath) ? "" : string.Concat("/", @applicationSettings.VirtualPath);
                foreach (var parent in Model)
                {
                    <li>
                        <a href="#">
                            <i class="@parent.Icon"></i>
                            <span>@parent.Title</span>
                            <i class="fa fa-angle-left float-right"></i>
                        </a>
                        <ul class="sidebar-submenu">
                            @foreach (var child in parent.Children)
                            {
                                <li id="@child.ControllerName.ToLower()">
                                    <a href="@(child.Children.Any() ? "#" : $"{urlPath}/{child.ControllerName}/{child.ViewName}")"
                                       data-selected="@child.ControllerName.ToLower()">
                                        <span>-</span>
                                        @child.Title
                                        @if (child.Children.Any())
                                        {
                                            <i class="fa fa-angle-left float-right"></i>
                                        }
                                    </a>
                                    @if (child.Children.Any())
                                    {
                                        <ul class="sidebar-submenu third-level">
                                            @foreach (var grandChild in child.Children)
                                            {
                                                <li id="@grandChild.ControllerName.ToLower()">
                                                    <a href="@(grandChild.Children.Any() ? $"{urlPath}/Menu/GreatGrandChildrenView?grandchildId={grandChild.MenuId}" : $"{urlPath}/{grandChild.ControllerName}/{grandChild.ViewName}")"
                                                       data-selected="@grandChild.ControllerName.ToLower()">
                                                        <span>--</span>
                                                        @grandChild.Title
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    </li>
                }
            }
        </ul>
    </section>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script> 

    $(document).ready(function () {

        $('.sidebar-menu').on('click', 'li > a', function (e) {

            var $this = $(this);
            var $submenu = $this.next('.sidebar-submenu');

            if ($submenu.length) {

                e.preventDefault();

                if ($submenu.is(':visible')) {

                    $submenu.slideUp(300);
                    $this.parent().removeClass('menu-open');

                } else {

                    $this.closest('ul').find('.sidebar-submenu:visible')
                        .slideUp(300)
                        .parent().removeClass('menu-open');

                    $submenu.slideDown(300);
                    $this.parent().addClass('menu-open');
                }
            }

        });


     var currentUrl = window.location.pathname.toLowerCase();

    $('.sidebar-menu a').each(function () {

        var linkUrl = $(this).attr('href');

        if (linkUrl && linkUrl !== "#" && currentUrl.includes(linkUrl.toLowerCase())) {

            $(this).addClass('active');

            $(this).parents('li').addClass('menu-open');

            $(this).parents('.sidebar-submenu').show();
        }

    });

    });
</script>