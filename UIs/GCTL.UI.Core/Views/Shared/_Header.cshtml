            <div class="input-group-append">
                <button class="btn btn-navbar" type="submit">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </form>
    <ul class="navbar-nav ml-auto">
        <li class="nav-item d-none d-sm-inline-block">
            @* <a asp-controller="EditUser" asp-action="Index" class="nav-link">
                <img src="~/images/UserIcon.png" alt="User" style="width: 20px; height: 20px;">         

                Welcome @ViewBag.LoginUser

            </a> *@
            <a class="nav-link" href="/EditUser" style="
    display: flex;
    align-items: center;
    gap: 6px;
">
                <img src="~/images/UserIcon.png" alt="User" style="
        width: 20px;
        height: 20px;
        border-radius: 50%;
        object-fit: cover;
    ">
                Welcome @ViewBag.LoginUser
            </a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a asp-controller="EditUser" asp-action="Index" class="nav-link">
                <i class="fas fa-key pr-2"></i>            Change Password

            </a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="@Url.Action("Logout", "Accounts")"
               class="nav-link logout-btn"><i class="fas fa-sign-out-alt pr-2"></i>Logout</a>
            </li>

    </ul>
</nav>


