@model ToobarModel

<div class="row">
	<div class="col-md-5">
		<h6 class="page-title px-3 text-black font-weight-bold" id="textLoanRecive"><b>NOC Entry</b></h6>
	</div>
	<div class="col-md-7 px-0">
		<div class="btn-toolbar d-flex justify-content-end">
			<div class="btn-group">
				<button type="button" class="btn btn-default success-btn " id="btnSave" data-toggle="tooltip" data-placement="bottom" title="Save">
					<i class="fa fa-save">&nbsp;</i> Save
				</button>
				<button type="button" class="btn btn-default success-btn" id="btnUpdate" data-toggle="tooltip" data-placement="bottom" title="Update">
					<i class="fa fa-edit mr-1"></i> Update
				</button>
				<button type="button" class="btn btn-default danger-btn" id="btnDelete" data-toggle="tooltip" data-placement="bottom" title="Delete">
					<i class="fa fa-trash">&nbsp;</i> Delete
				</button>
				<button type="button" class="btn btn-default primary-btn " id="js-noc-entry-clear"  data-toggle="tooltip" data-placement="bottom" title="Clear">
					<i class="fa fa-eraser">&nbsp;</i> Clear
				</button>
				<button type="button" class="btn btn-default info-btn js-loan-entry-report-print"  data-toggle="tooltip" data-placement="bottom" title="Print">
					<i class="fa fa-print">&nbsp;</i> Print
				</button>
				<button type="button" class="btn btn-default warning-btn js-loan-entry-report-favorite"  data-toggle="tooltip" data-placement="bottom" title="Favorite">
					<i class="fa fa-star">&nbsp;</i> Favorite
				</button>
			</div>
		</div>
	</div>
</div>
